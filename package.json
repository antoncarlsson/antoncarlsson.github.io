{
  "name": "typescript-web-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @workspace/web start",
    "lint": "oxlint --type-aware --deny-warnings && node scripts/check-repository.mjs",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @workspace/web test:watch",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm build && pnpm --filter @workspace/web test:e2e"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@12.4.2"
}
