# Optional. The base application runs without an environment file.
# Copy to .env.local to override public build-time configuration.
VITE_APP_NAME="AWesome Template"

# Server runtime configuration. No paths or trailing slash.
# APP_ORIGIN=https://app.example.com
# LOG_LEVEL=info
# OTEL_SERVICE_NAME=workspace-web
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
# Add secrets here only as empty placeholders; never use a VITE_ prefix for secrets.
